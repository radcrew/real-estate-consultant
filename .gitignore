node_modules
.pnpm-store

# Next.js (frontend)
frontend/.next
frontend/out

# Env (never commit secrets — includes MCP_API_KEY / JWTs)
.env
.env*.local
services/mcp/.auth.json

# Vercel local link metadata
.vercel
**/.vercel

# Python bytecode and caches. backend/ has its own copy of these rules; this covers
# every other Python directory — infra/, scripts/, services/ — which would otherwise
# expose __pycache__ the moment one of them is first added to git.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Coverage artifacts. `.coverage` is a binary SQLite database rewritten by every
# `pytest --cov` run — including the CI coverage job — so tracking it means a dirty tree
# after running the tests and a merge conflict no one can resolve by hand.
.coverage
.coverage.*
coverage.json
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
*.log

# Tool-generated temp files (e.g. <file>.tmp.<pid>.<hash>)
*.tmp.*

# Claude Code local overrides (permissions, hooks) — not shared across clones
.claude/settings.local.json

# Local model tooling: llama.cpp binaries, weights, GGUFs. Multi-GB and rebuildable
# from ml/intake-parser — never committed.
.local/

# Coverage databases and reports. `.coverage` is a binary SQLite file rewritten by every
# `pytest --cov`, so a tracked copy is a diff on every test run and merge conflicts that
# mean nothing. Three were tracked before this rule; all three are now untracked, because
# a tracked file ignores what is written here and the rule would have been a lie for them.
.coverage
.coverage.*
coverage.json
htmlcov/
