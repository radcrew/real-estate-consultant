node_modules
.pnpm-store

# Next.js (frontend)
frontend/.next
frontend/out

# Env (never commit secrets — includes MCP_API_KEY / JWTs)
.env
.env*.local
services/mcp/.auth.json

# Vercel local link metadata
.vercel
**/.vercel

# Python bytecode and caches. backend/ has its own copy of these rules; this covers
# every other Python directory — infra/, scripts/, services/ — which would otherwise
# expose __pycache__ the moment one of them is first added to git.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# OS / editor
.DS_Store
Thumbs.db
*.log

# Tool-generated temp files (e.g. <file>.tmp.<pid>.<hash>)
*.tmp.*

# Claude Code local overrides (permissions, hooks) — not shared across clones
.claude/settings.local.json
