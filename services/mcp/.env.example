# FastAPI backend base URL (no trailing slash). Local default matches backend README.
BACKEND_API_URL=http://127.0.0.1:8888

# Required for authenticated tools. Paste a short-lived Supabase user access token —
# never the service role key. Admin tools need profiles.is_admin.
MCP_USER_ACCESS_TOKEN=

# stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8900

HTTP_TIMEOUT_SECONDS=60
RATE_LIMIT_PER_MINUTE=60
MAX_TOOL_OUTPUT_CHARS=24000
LOG_LEVEL=INFO
