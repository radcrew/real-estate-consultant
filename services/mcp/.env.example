# FastAPI backend base URL (no trailing slash). Local default matches backend README.
BACKEND_API_URL=http://127.0.0.1:8888

# Optional for Phase 0 ping. Required once authenticated tools land (Phase 1+).
# Paste a short-lived Supabase user access token — never the service role key.
MCP_USER_ACCESS_TOKEN=

# stdio | streamable-http  (Phase 0 uses stdio only)
MCP_TRANSPORT=stdio

HTTP_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
