# FastAPI backend base URL (no trailing slash).
# Local: http://127.0.0.1:8888
# Vercel MCP project: https://real-estate-consultant-be.vercel.app
BACKEND_API_URL=http://127.0.0.1:8888

# Preferred: long-lived MCP API key (prefix rad_…). Created via backend account API.
# For local stdio only — do NOT set on the shared Vercel MCP deployment (header-only auth).
MCP_API_KEY=

# Deprecated fallback: short-lived Cognito user access token. Prefer MCP_API_KEY.
MCP_USER_ACCESS_TOKEN=

# stdio | streamable-http (local process). Vercel ASGI entry ignores this and always serves HTTP.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8900
# Set true for serverless / Vercel (ASGI entry forces true). Local HTTP may stay false.
MCP_STATELESS_HTTP=false

# Keep below Vercel function maxDuration (60s in vercel.json).
HTTP_TIMEOUT_SECONDS=55
RATE_LIMIT_PER_MINUTE=60
MAX_TOOL_OUTPUT_CHARS=24000
LOG_LEVEL=INFO

# Local scripts only (create_mcp_api_key.py, setup_local_auth.py): the account they sign in
# as. Empty uses the defaults in app/config.py, which only work on a pool that auto-confirms.
MCP_LOCAL_EMAIL=
MCP_LOCAL_PASSWORD=
