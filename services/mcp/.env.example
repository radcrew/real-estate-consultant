# FastAPI backend base URL (no trailing slash). Local default matches backend README.
BACKEND_API_URL=http://127.0.0.1:8888

# Preferred: long-lived MCP API key (prefix rad_…). Created via backend account API (Phase 1+).
MCP_API_KEY=

# Deprecated fallback — short-lived Supabase user JWT. Prefer MCP_API_KEY once keys ship.
# Never the service role key. Admin tools need profiles.is_admin.
MCP_USER_ACCESS_TOKEN=

# stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8900

HTTP_TIMEOUT_SECONDS=60
RATE_LIMIT_PER_MINUTE=60
MAX_TOOL_OUTPUT_CHARS=24000
LOG_LEVEL=INFO
