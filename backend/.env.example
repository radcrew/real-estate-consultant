# Required — Postgres (Supabase). Use port 6543 + DB_SERVERLESS=true on Vercel serverless.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DB_SERVERLESS=false
# Stop a flaky database call from running until the platform kills the function.
DB_CONNECT_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT_MS=30000

# Required — Supabase project
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# false lets sign-ups in without confirming their email address.
SIGNUP_EMAIL_CONFIRM=true

# Comma-separated browser origins allowed to call the API (Next dev/prod URLs).
FRONTEND_ORIGIN=http://localhost:3000,https://localhost:3000

# --- Chat LLM (Smart Chat, intake, fit, outreach) ---
# Priority: OPENROUTER_API_KEY wins when set; else HF_TOKEN; else chat returns "AI unavailable".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct
# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Real Estate Consultant

HF_TOKEN=
HF_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_BASE_URL=https://router.huggingface.co/v1
# Embeddings speak HF's feature-extraction protocol, which llama.cpp does not implement,
# so this stays on the router even when intake is pinned elsewhere.
HF_EMBEDDING_BASE_URL=https://router.huggingface.co/v1

# Pin intake criteria extraction to a self-hosted OpenAI-compatible server
# (e.g. llama-server). Leave all three empty to keep intake on the default chat
# provider; clearing them is the rollback, an env change with no code revert.
# Outreach, fit explanations and the opening question are never affected.
# INTAKE_CHAT_API_KEY must match the server's --api-key. Do not reuse HF_TOKEN:
# the box would then hold a credential to your Hugging Face account.
INTAKE_CHAT_MODEL=
INTAKE_CHAT_BASE_URL=
INTAKE_CHAT_API_KEY=

# --- Embeddings (separate resolver from chat) ---
# Priority: HF_TOKEN wins when set; else OPENROUTER_API_KEY; else "Embeddings unavailable".
# OPENROUTER_EMBEDDING_MODEL is used only when HF_TOKEN is empty and OPENROUTER_API_KEY is set.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional cost telemetry (USD per 1M tokens; 0 disables estimates)
OPENROUTER_INPUT_COST_PER_1M=0
OPENROUTER_OUTPUT_COST_PER_1M=0
HF_INPUT_COST_PER_1M=0
HF_OUTPUT_COST_PER_1M=0

# --- AWS Bedrock ---
# Region is required for every Bedrock call: neither boto3 nor the Anthropic Bedrock
# client applies a default, and an empty value makes both providers raise 503 instead
# of guessing. Leave blank to keep Bedrock off entirely.
AWS_REGION=

# Credentials are NOT settings — boto3 resolves them from the standard chain, which
# reads the process environment and ~/.aws/credentials, not this file. Locally, use an
# AWS profile or export these in your shell; on Vercel set them as project env vars.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Embeddings run on bedrock-runtime InvokeModel (versioned model IDs). Must produce 1024
# dims, which is what properties.embedding is declared as — changing model means a full
# re-embed. Regions differ: eu-north-1 has no cohere.embed-english-v3 and reaches v4 only
# through an inference profile, so use BEDROCK_EMBEDDING_MODEL=eu.cohere.embed-v4:0 there.
BEDROCK_EMBEDDING_MODEL=cohere.embed-english-v3
BEDROCK_EMBEDDING_BATCH_SIZE=96
# v4 defaults to 1536, which the vector(1024) column rejects, so pin the width whenever
# the model is v4. Leave 0 for v3: it has one fixed width and rejects the parameter.
BEDROCK_EMBEDDING_DIMENSIONS=0

# Chat runs on the Bedrock Messages API (anthropic. prefix, no date suffix). Built but
# not routed by default; outreach is planned to move to Qwen3-32B instead.
BEDROCK_CHAT_MODEL=anthropic.claude-sonnet-5
BEDROCK_EFFORT=low
BEDROCK_DISABLE_THINKING=true
BEDROCK_INPUT_COST_PER_1M=0
BEDROCK_OUTPUT_COST_PER_1M=0

# Qwen chat on Bedrock runs through the vendor-neutral Converse API instead (the
# Anthropic SDK above cannot call non-Anthropic models). Reached only by pinning a route
# to "bedrock_qwen" — key presence cannot tell the two Bedrock providers apart.
BEDROCK_QWEN_CHAT_MODEL=qwen.qwen3-32b-v1:0
# false omits the field entirely, for a model revision that rejects the switch.
BEDROCK_QWEN_DISABLE_THINKING=true
BEDROCK_QWEN_INPUT_COST_PER_1M=0
BEDROCK_QWEN_OUTPUT_COST_PER_1M=0

# --- Qwen2.5-0.5B intake parser (self-hosted on Lambda, invoked over IAM) ---
# Empty name disables the provider. Reached only by LLM_ROUTE_INTAKE_PARSE=qwen, and it
# serves that one call site: the fine-tune knows one schema and does not transfer.
QWEN_INFERENCE_FUNCTION_NAME=
# Free-text label recorded on every llm_call, so a retrain can be attributed later.
QWEN_MODEL_VERSION=

# --- Per-call-site model routing (app/llm/providers/routing.py) ---
# "auto" defers to the key-presence order above, which checks Bedrock last so a metered
# provider is never selected merely because a region is configured. Any other value pins
# that path: openrouter | huggingface | bedrock | bedrock_qwen. An unknown value raises
# 503 rather than falling back, so a typo cannot silently redirect traffic.
LLM_ROUTE_INTAKE_PARSE=auto
LLM_ROUTE_OPENING_QUESTION=auto
LLM_ROUTE_FIT_EXPLANATION=auto
LLM_ROUTE_OUTREACH_DRAFT=auto
LLM_ROUTE_DEFAULT=auto

# Embeddings must be pinned to reach Bedrock: while HF_TOKEN is set, key-presence order
# keeps the 384-dim MiniLM model, which cannot fill the 1024-dim properties.embedding
# column — so similar-listings stays empty until this is "bedrock".
LLM_ROUTE_EMBEDDINGS=auto

# MCP API keys (rad_…) — pepper for sha256(key) lookup; required in production
MCP_API_KEY_PEPPER=
# Per-key sliding window, counted per process — the effective ceiling scales with the
# number of live instances.
MCP_API_KEY_RATE_LIMIT_PER_MINUTE=120

# Admission control for the anonymous, LLM-backed intake routes. Both windows are
# in-process, so the real ceiling is these numbers times the instance count. The address
# budget is the meaningful one: intake sessions are free to create, so a per-session
# limit alone just moves an abuser to a new session.
INTAKE_IP_RATE_LIMIT_PER_MINUTE=60
INTAKE_SESSION_RATE_LIMIT_PER_MINUTE=12

# FIFO queue for intake turns (must end in .fifo). Empty runs each turn inline, which is
# the default for local development and CI — no queue required.
SQS_CHAT_QUEUE_URL=
# How long the client follows a turn lives in the frontend (JOB_DEADLINE_MS) — it polls,
# so the backend holds no per-client state.
# Jobs left "running" longer than this are treated as dead — a worker killed mid-turn
# leaves a claim redelivery can never finish. Last link in an ordered chain: worst-case
# provider call < worker function timeout < queue visibility timeout < this. The provider
# end dominates (OpenRouter alone is a 75s read timeout with 3 retries).
CHAT_JOB_STALE_AFTER_SECONDS=420
# Jobs nothing ever picked up (failed publish, worker down, message exhausted into the
# DLQ). Measures untouched time, so it only needs to clear one visibility timeout — a job
# being redelivered refreshes updated_at on each attempt. Keep it in step with the
# frontend's JOB_DEADLINE_MS (how long the client follows a turn): higher and a user told
# their turn failed is also told it is still running; lower and jobs are cleared while
# someone is still watching.
CHAT_JOB_ABANDONED_AFTER_SECONDS=600
# Unfinished turns per session. FIFO already serialises them, so a second in flight only
# waits behind the first while multiplying the work one session can queue.
INTAKE_MAX_ACTIVE_JOBS_PER_SESSION=1

# --- Bedrock Guardrails on intake free text (opt-in, priced per text unit) ---
# Empty id disables screening entirely. The user's message is screened before the job row
# is written, so what gets stored is already redacted.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# Also screen the assistant's generated question. Doubles the per-turn cost for text that
# is template-driven, so it stays off unless you want it.
BEDROCK_GUARDRAIL_SCREEN_OUTPUT=false
# true keeps intake working during a guardrail outage, at the cost of storing text that
# nothing screened. false refuses the turn instead.
BEDROCK_GUARDRAIL_FAIL_OPEN=false

# Ingestion microservice (optional — empty disables enqueue from backend)
INGESTION_SERVICE_URL=
INGESTION_SERVICE_TOKEN=

LOG_LEVEL=INFO

# SolarWinds Observability log shipping. Leave blank to disable; the token is a secret.
SWO_LOGS_URL=
SWO_TOKEN=
